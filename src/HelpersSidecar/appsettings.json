{
  "Listener": {
    "Address": "127.0.0.1",
    "Port": 5050
  },
  "SkillDispatch": {
    "BaseUrl": "http://127.0.0.1:5050",
    "TimeoutSeconds": 10
  },
  "Otel": {
    "CollectorExePath": "dist/windows-amd64/claude-otel-collector.exe",
    "CollectorConfigFile": "config.yaml"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
