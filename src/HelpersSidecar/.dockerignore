# Keep the docker build context tight — exclude every artefact
# that's regenerated by the SDK in the build stage AND every
# project the sidecar doesn't ship.

# Build outputs
**/bin/
**/obj/

# Tests (image is runtime-only)
tests/

# Skill markdown (skills aren't loaded inside the container —
# they live on the host).
.claude/

# Project-level docs
docs/
*.md

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Plan / runtime state
.claude/runtime/
output/
persistent-enrichments.json

# Git metadata
.git/
.gitignore
.gitattributes
