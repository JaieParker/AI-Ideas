# Collector runtime output (regenerated on every run)
output/

# Persistent enrichments — local state, not config
persistent-enrichments.json

# .NET project build output (any project subdir; the repo's shipped
# binaries live at top-level dist/, which stays tracked)
**/bin/
**/obj/
!dist/
!dist/**

# Promote-snapshot directories (BR-PROCESS-012). These hold the
# previous blue binary so a failed promote can roll back. They
# regenerate on every promote attempt; gitignored.
**/bin.bak/
**/Debug.bak/

# Go build output
components/**/*.test
components/**/*.exe

# Node deps (skill helpers don't have any today, but defensive)
node_modules/

# Claude Code local overrides
.claude/settings.local.json

# Process lifecycle runtime state — PID files for the sidecar (and,
# post-Plan-5, the collector). Deleted on graceful shutdown; swept
# by /skill-bootstrap on the next start (BR-PROCESS-008).
.claude/runtime/

# Per-machine sidecar overrides — single source of truth for local
# CollectorOptions changes (BR-OTEL-007). Loaded by Program.cs after
# appsettings.{Env}.json so values here win. Never committed.
src/HelpersSidecar/appsettings.Local.json

# Secret-shaped files (defensive — none expected, refuse anyway)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo

# Logs
*.log

# Plan-mode auto-named scratch (in case any leak into the project)
we-are-planning-*.md
tools/go/
dist/*/_build/
